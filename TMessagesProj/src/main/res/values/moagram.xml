    <string name="GhostMode">Ghost Mode</string>
    <string name="GhostModeSubtitle">Control presence and stealth browsing</string>
    <string name="GhostModeEnable">Enable Ghost Mode</string>
    <string name="GhostModeEnableInfo">Browse Moagram stealthily without broadcasting your online status, typing indicators, or read receipts.</string>
    <string name="GhostModeOnline">Hide Online Status</string>
    <string name="GhostModeOnlineInfo">Do not announce your online presence to Moagram. You appear offline while continuing to receive live online updates of other users.</string>
    <string name="GhostModeTyping">Hide Typing Status</string>
    <string name="GhostModeTypingInfo">Do not send \'typing...\' or recording indicators when replying to chats.</string>
    <string name="GhostModeRead">Ghost Read</string>
    <string name="GhostModeReadInfo">Messages are marked as read only on this device. Senders will continue to see them as unread.</string>
    <string name="GhostModeMarkOnReply">Mark as Read on Reply</string>
    <string name="GhostModeMarkOnReplyInfo">Automatically mark messages in a chat as read only when you send a reply in that chat.</string>
    <string name="GhostModeStories">Anonymous Stories</string>
    <string name="GhostModeStoriesInfo">View stories without appearing in the story viewers list.</string>
    <string name="GhostModeStealthSend">Stealth Send</string>
    <string name="GhostModeStealthSendInfo">Mark messages and saves as background traffic and immediately restore offline status, preventing Moagram from updating your Last Seen or broadcasting you online while keeping other people\'s online status visible.</string>
    <string name="GhostModeNotice">Note: Moagram servers normally update your last seen when you send a message. Ghost Mode flags outgoing messages as background traffic and immediately sends an offline status packet to keep you appearing offline while still seeing others online.</string>
    <string name="SaveRestrictedContent">Allow Saving Restricted Content</string>
    <string name="SaveRestrictedContentInfo">Allow saving media to gallery, copying text, taking screenshots, and forwarding messages from channels and groups that restrict content saving.</string>
    <string name="SaveDeletedMessages">Save Deleted Messages</string>
    <string name="SaveDeletedMessagesInfo">Keep messages that were deleted by other users or administrators in your chats.</string>
    <string name="SaveDeletedMedia">Keep Media of Deleted Messages</string>
    <string name="SaveDeletedMediaInfo">Retain photos, videos, and files from deleted messages in local cache instead of wiping them.</string>
